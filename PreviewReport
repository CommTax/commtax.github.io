    // ============================================================
    // HELPER FUNCTIONS (Copy from full version)
    // ============================================================
    function formatNumber(num) {
        if (!num) return '0';
        return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    }

    function getScoreColor(score) {
        if (score >= 70) return '#00C4A7';
        if (score >= 50) return '#F59E0B';
        return '#EF4444';
    }

    function parsePct(value) {
        if (!value) return 0;
        if (typeof value === 'string') {
            var cleaned = value.replace('%', '').trim();
            return parseFloat(cleaned) || 0;
        }
        return Number(value) || 0;
    }

    // ============================================================
    // CHECK UNLOCK STATUS
    // ============================================================
    function checkUnlockStatus() {
        if (paymentId) {
            isUnlocked = true;
            sessionStorage.setItem('unlocked_' + submissionId, 'true');
            return true;
        }
        if (sessionStorage.getItem('unlocked_' + submissionId) === 'true') {
            isUnlocked = true;
            return true;
        }
