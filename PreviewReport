    function renderWaterfall(data) {
        var container = document.getElementById('waterfallContainer');
        if (!container) return;

        var communication = parsePct(data.communicationPct);
        var understanding = parsePct(data.understandingPct);
        var opportunity = parsePct(data.opportunityPct);
        var thinking = parsePct(data.thinkingPct);
        var structure = parsePct(data.structurePct);

        var items = [
            { label: 'Communication', value: Math.max(0, 60 - communication) * 100000, color: '#EF4444' },
            { label: 'Opportunity', value: Math.max(0, 60 - opportunity) * 150000, color: '#F97316' },
            { label: 'Understanding', value: Math.max(0, 60 - understanding) * 50000, color: '#F59E0B' },
            { label: 'Thinking', value: Math.max(0, 60 - thinking) * 0, color: '#00C4A7' },
            { label: 'Structure', value: Math.max(0, 60 - structure) * 0, color: '#10B981' }
        ];

        var total = 0;
        items.forEach(function(item) { total += item.value; });

        if (total === 0) {
            container.innerHTML = '<div style="text-align:center;padding:20px;color:#6B7280;">✅ No significant tax leakage detected.</div>';
            return;
        }

        var maxVal = Math.max(total, 1);
        var html = '';

        items.forEach(function(item) {
            if (item.value > 0) {
                var pct = (item.value / maxVal) * 100;
                html +=
                    '<div class="wf-row">' +
                    '<span class="wf-label">' + item.label + '</span>' +
                    '<div class="wf-bar"><div class="wf-fill" style="width:' + Math.min(pct, 100) + '%;background:' + item.color + ';"></div></div>' +
                    '<span class="wf-amount" style="color:' + item.color + ';">₹' + formatNumber(item.value) + '</span>' +
                    '</div>';
            }
        });

        html +=
            '<div class="wf-total">' +
            '<span>TOTAL ANNUAL TAX</span>' +
            '<span class="wf-total-amount">₹' + formatNumber(total) + '</span>' +
            '</div>';

        container.innerHTML = html;
    }

