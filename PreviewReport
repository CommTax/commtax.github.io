            alert('Payment system is being configured. Please contact support.');
            return;
        }

        var payBtn = document.getElementById('payButtonSticky');
        payBtn.disabled = true;
        payBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';

        var options = {
            key: RAZORPAY_KEY_ID,
            amount: 99900,
            currency: 'INR',
            name: 'The Unspoken',
            description: 'Communication Tax™ Full Report',
            prefill: { email: reportData ? reportData.email : '' },
            notes: { submissionId: submissionId },
            handler: function(response) {
                window.location.href = window.location.pathname + '?id=' + submissionId + '&payment_id=' + response.razorpay_payment_id;
            },
            modal: {
                ondismiss: function() {
                    payBtn.disabled = false;
                    payBtn.innerHTML = '<i class="fas fa-unlock"></i> Unlock Now';
                }
            }
        };

        try {
            var rzp = new Razorpay(options);
            rzp.open();
        } catch (error) {
            console.error('Payment error:', error);
            alert('Payment system error. Please try again.');
            payBtn.disabled = false;
            payBtn.innerHTML = '<i class="fas fa-unlock"></i> Unlock Now';
        }
    }

