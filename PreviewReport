    // ============================================================
    // RENDER DNA - Copy from full version
    // ============================================================
    function renderDNA(data) {
        var labels = ['Strategic Thinking', 'Executive Presence', 'Influence', 'Persuasion', 'Confidence', 'Listening', 'Adaptability'];

        var thinkingPct = parsePct(data.thinkingPct);
