        var competencies = [
            { id: 'Thinking', score: parsePct(data.thinkingPct), level: data.thinkingLevel || 'Proficient' },
            { id: 'Structure', score: parsePct(data.structurePct), level: data.structureLevel || 'Proficient' },
            { id: 'Communication', score: parsePct(data.communicationPct), level: data.communicationLevel || 'Needs Attention' },
            { id: 'Understanding', score: parsePct(data.understandingPct), level: data.understandingLevel || 'Needs Attention' },
            { id: 'Opportunity', score: parsePct(data.opportunityPct), level: data.opportunityLevel || 'Proficient' }
        ];

        competencies.forEach(function(comp) {
            var color = getScoreColor(comp.score);
            var div = document.createElement('div');
            div.className = 'ring-item';
            div.style.textAlign = 'center';
            div.innerHTML =
                `<canvas id="ringCanvas_${comp.id}" width="120" height="120"></canvas>
                <div style="font-weight:700;font-size:14px;margin-top:6px;color:#0B0F1A;">${comp.id}</div>
                <div style="font-weight:700;font-size:16px;color:${color};">${comp.score}%</div>
                <div style="font-size:12px;color:#6B7280;">${comp.level}</div>`;
            container.appendChild(div);
            setTimeout(function() {
                drawRing('ringCanvas_' + comp.id, comp.score, color);
            }, 150);
        });
    }

