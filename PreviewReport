        if (payBtn) payBtn.addEventListener('click', initiatePayment);
    }

    // ============================================================
    // START THE APP
    // ============================================================
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

    // ============================================================
    // EXPOSE GLOBALLY
    // ============================================================
    window.initiatePayment = initiatePayment;
</script>
</body>
</html>
