    // ============================================================
    // FETCH REPORT DATA
    // ============================================================
    async function fetchReportData() {
        if (!submissionId) {
            document.getElementById('reportContainer').innerHTML =
                '<div style="padding:60px 20px;text-align:center;"><h2 style="color:#991B1B;">⚠️ Missing Submission ID</h2><p style="color:var(--gray-500);">Please add <code>?id=YOUR_SUBMISSION_ID</code> to the URL.</p></div>';
            return null;
        }

        try {
            var url = APPS_SCRIPT_URL + '?action=getReportData&id=' + encodeURIComponent(submissionId);
            var response = await fetch(url);
            var result = await response.json();

            if (result.success && result.data) {
                return result.data;
            } else {
                throw new Error(result.error || 'Report not found');
            }
        } catch (error) {
            document.getElementById('reportContainer').innerHTML =
                '<div style="padding:60px 20px;text-align:center;"><h2 style="color:#991B1B;">⚠️ Error Loading Report</h2><p style="color:var(--gray-500);">' +
                error.message + '</p></div>';
            return null;
        }
    }

    // ============================================================
    // DRAW RING - Copy from full version
    // ============================================================
    function drawRing(canvasId, score, color) {
        var canvas = document.getElementById(canvasId);
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        var cx = 60, cy = 60, radius = 48;
        var startAngle = -Math.PI / 2;
        var endAngle = startAngle + (score / 100) * 2 * Math.PI;

        ctx.clearRect(0, 0, 120, 120);
        ctx.beginPath();
        ctx.arc(cx, cy, radius, 0, 2 * Math.PI);
        ctx.strokeStyle = '#F3F4F6';
        ctx.lineWidth = 8;
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(cx, cy, radius, startAngle, endAngle);
        ctx.strokeStyle = color;
        ctx.lineWidth = 8;
        ctx.lineCap = 'round';
        ctx.stroke();
        ctx.fillStyle = color;
        ctx.font = 'bold 18px Inter, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(score + '%', cx, cy);
    }

    // ============================================================
    // RENDER RINGS - Copy from full version
    // ============================================================
    function renderRings(data) {
        var container = document.getElementById('ringsGrid');
        if (!container) return;
