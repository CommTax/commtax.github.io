/* ============================================================
   STICKY PAYMENT OVERLAY - FLOATING
   ============================================================ */
.sticky-payment-overlay {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(180deg, rgba(10, 14, 26, 0.8) 0%, var(--navy) 100%);
    padding: 20px 30px;
    z-index: 9999;
    backdrop-filter: blur(12px);
    border-top: 3px solid var(--teal);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    transform: translateY(0);
    transition: transform 0.3s ease;
}

.sticky-payment-overlay .payment-content {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
}

.sticky-payment-overlay .payment-content .lock-icon {
    color: var(--gold);
    font-size: 28px;
}

.sticky-payment-overlay .payment-content .payment-text {
    color: var(--white);
}

.sticky-payment-overlay .payment-content .payment-text .title {
    font-size: 18px;
    font-weight: 700;
    color: var(--white);
}

.sticky-payment-overlay .payment-content .payment-text .sub {
    font-size: 13px;
    color: rgba(255,255,255,0.5);
}

.sticky-payment-overlay .payment-content .payment-text .highlight {
    color: var(--teal);
    font-weight: 700;
}

.sticky-payment-overlay .payment-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
}

.sticky-payment-overlay .payment-actions .price {
    font-size: 28px;
    font-weight: 900;
    color: var(--teal);
}

.sticky-payment-overlay .btn-pay-sticky {
    background: var(--teal);
    color: var(--white);
    border: none;
    padding: 14px 40px;
    border-radius: 50px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.3s;
    box-shadow: 0 8px 32px rgba(0, 196, 167, 0.4);
    white-space: nowrap;
}

.sticky-payment-overlay .btn-pay-sticky:hover {
    background: var(--teal-dark);
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(0, 196, 167, 0.5);
}

.sticky-payment-overlay .btn-pay-sticky i {
    margin-right: 8px;
}

.sticky-payment-overlay .btn-pay-sticky:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
}

/* Hide sticky payment when unlocked */
.sticky-payment-overlay.hidden {
    display: none;
}

@media (max-width: 768px) {
    .sticky-payment-overlay {
        padding: 16px 20px;
        flex-direction: column;
        text-align: center;
    }
    .sticky-payment-overlay .payment-content {
        flex-direction: column;
        gap: 8px;
        text-align: center;
    }
    .sticky-payment-overlay .payment-actions {
        width: 100%;
        justify-content: center;
    }
    .sticky-payment-overlay .btn-pay-sticky {
